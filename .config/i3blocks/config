[volume]
command=echo "volume: $(pactl get-sink-volume $(pactl get-default-sink) | grep % | awk '{print$5}') $(pactl get-sink-mute $(pactl get-default-sink) | awk '{print$2}' | sed 's/no//' | sed 's/yes/mute/')"
interval=once
signal=10
color=#AAFF00

[backlight]
command=echo "brightness:  $(brightnessctl | grep "%" | awk '{print $4}' | sed 's/(//' | sed 's/)//')"
interval=once
signal=11
color=#00FF00

[battery]
command=echo "battery: $(cat /sys/class/power_supply/BAT0/status | sed 's/Discharging//' | sed 's/Charging/+/' | sed 's/Full/!/')$(cat /sys/class/power_supply/BAT0/capacity)%"
interval=30
signal=14
color=#FFAAAA

