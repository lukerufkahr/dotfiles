### MY THEME ### 

# Colors
# class                 border  bground text    indicator child_border
client.focused          #6c757d #495057 #f8f9fa #000000   #6c757d
client.focused_inactive #000000 #000000 #FFFFFF #000000   #000000
client.unfocused        #343a40 #212529 #ced4da #000000   #343a40
client.urgent           #000000 #900000 #FFFFFF #900000   #900000
client.placeholder      #000000 #000000 #FFFFFF #000000   #000000

client.background       #FFFFFF

# Font
font pango:Noto Sans Regular 10

# Hide titlebar
#for_window [class="^.*"] border pixel 1

# Hide i3bar
bar {
	position top
	tray_output none
	status_command i3blocks
	hidden_state hide
	modifier $mod
	separator_symbol "|"
	workspace_min_width 50px
	padding 2px 0
}

# Window Icon
for_window [all] title_window_icon no
